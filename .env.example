# IPOS Environment Configuration Template
# Copy to .env and fill in real secrets. Never commit .env.

# --- FRED API (St. Louis Fed) ---
# FRED_API_KEY=your_fred_api_key_here

# --- Karakeep Evidence Custody (WSL2 Docker / Local) ---
KARAKEEP_URL=http://127.0.0.1:3000
KARAKEEP_API_KEY=your_karakeep_api_key_here

# --- Hermes / Telegram Weekly Dispatch ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# TELEGRAM_THREAD_ID=optional_thread_or_topic_id
