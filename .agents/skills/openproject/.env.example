# Copy to a LOCAL, git-ignored env file (or export in your shell). NEVER commit a real token.
# The skill reads these from the environment only — no token is ever stored in the repo.

# Private Leela OpenProject base URL (the fresh 17.8 instance; NOT community, NOT the stopped duplicate)
OPENPROJECT_BASE_URL=http://127.0.0.1:8083

# API key from the dedicated least-privilege Leela agent account (create in OpenProject → My account → Access tokens)
OPENPROJECT_TOKEN=

# Write-safety fingerprint — the client refuses to write if the live instance does not match these.
OPENPROJECT_EXPECT_VERSION_PREFIX=17.
OPENPROJECT_EXPECT_HOST=127.0.0.1:8083
# OPENPROJECT_EXPECT_INSTANCE_NAME=

# Optional: set to 0 ONLY in a disposable write lab to bypass the two-phase confirm gate.
# OP_WRITE_CONFIRM=1
